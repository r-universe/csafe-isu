[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "handwriter"]
	path = handwriter
	url = https://github.com/csafe-isu/handwriter
[submodule "handwriterApp"]
	path = handwriterApp
	url = https://github.com/csafe-isu/handwriterapp
[submodule "handwriterRF"]
	path = handwriterRF
	url = https://github.com/csafe-isu/handwriterrf
